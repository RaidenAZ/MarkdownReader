<ui:FluentWindow x:Class="MarkdownReader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:web="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="Folio" Icon="pack://application:,,,/Assets/app.ico"
    Width="1180" Height="800" MinWidth="660" MinHeight="460"
    FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
    WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
    AllowDrop="True" PreviewDragOver="DragOverWindow" PreviewDrop="DropOnWindow"
    Loaded="InitializeWindow" Closing="SaveWindowPlacement" Closed="CloseWindow" PreviewKeyDown="OnWindowKey">
    <Window.Resources>
        <Style x:Key="GhostIconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarActionButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar ShowMaximize="True" ShowMinimize="True" ShowClose="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource GhostIconButton}" ToolTip="切换侧栏 (Ctrl+B)" AutomationProperties.Name="切换侧栏" Click="ToggleSidebar">
                        <Path Data="M3.5,2.5 H14.5 A1.5,1.5 0 0 1 16,4 V14 A1.5,1.5 0 0 1 14.5,15.5 H3.5 A1.5,1.5 0 0 1 2,14 V4 A1.5,1.5 0 0 1 3.5,2.5 Z M6.5,2.5 V15.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.35" Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource SidebarActionButton}" Height="28" Padding="8,0" Margin="2,0,0,0"
                            ToolTip="返回起始页 (Ctrl+Home)" Click="ReturnHome">
                        <TextBlock Text="Folio" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Button>
                    <TextBlock x:Name="TitleSeparator" Text="/" FontSize="13" Opacity="0.32" Margin="2,0,8,0"
                               VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                    <TextBlock x:Name="DocumentName" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="280"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" IsHitTestVisible="False" />
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border x:Name="WatchBadge" Visibility="Collapsed" CornerRadius="10" Padding="8,3" Margin="0,0,6,0"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="WatchDot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="WatchStatus" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource GhostIconButton}" ToolTip="页内查找 (Ctrl+F)" AutomationProperties.Name="页内查找" Click="OpenFind">
                        <Path Data="M10.8,9.8 L14.5,13.5 M6.8,11.2 A4.4,4.4 0 1 1 6.8,2.4 A4.4,4.4 0 0 1 6.8,11.2 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource GhostIconButton}" ToolTip="排版与宽度" AutomationProperties.Name="排版" Click="OpenTypography">
                        <TextBlock Text="Aa" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource GhostIconButton}" ToolTip="外观主题" AutomationProperties.Name="主题" Click="OpenTheme">
                        <Path Data="M8,1.8 A6.2,6.2 0 1 0 14.2,8 A4.8,4.8 0 0 1 8,1.8 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Sidebar" Width="228" Padding="10,6,6,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Opacity="0.55" Margin="8,0,8,8" />
                        <Button Style="{StaticResource SidebarActionButton}" Click="ChooseFile">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M8,3 V13 M3,8 H13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock Text="打开文档…" FontSize="12.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarActionButton}" Click="ChooseFolder" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M2,4.5 A1.5,1.5 0 0 1 3.5,3 H6.5 L8,4.8 H13.5 A1.5,1.5 0 0 1 15,6.3 V12.5 A1.5,1.5 0 0 1 13.5,14 H3.5 A1.5,1.5 0 0 1 2,12.5 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.35" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform"
                                      Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="打开文件夹…" FontSize="12.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel x:Name="WorkspaceSection" Visibility="Collapsed" Margin="0,0,0,14">
                                <DockPanel Margin="8,2,4,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostIconButton}" Width="24" Height="24"
                                            ToolTip="关闭工作区" Click="CloseWorkspace">
                                        <Path Data="M4,4 L12,12 M12,4 L4,12"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="10" Height="10" Stretch="Uniform" />
                                    </Button>
                                    <TextBlock x:Name="WorkspaceTitle" Text="工作区" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <ui:TextBox x:Name="WorkspaceFilter" PlaceholderText="筛选文档…" FontSize="12"
                                            Margin="4,0,4,6" TextChanged="FilterWorkspace" />
                                <TreeView x:Name="WorkspaceTree" Background="Transparent" BorderThickness="0"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          SelectedItemChanged="SelectWorkspaceFile">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                </TreeView>
                                <TextBlock x:Name="WorkspaceHint" Opacity="0.58" FontSize="12" Margin="10,4,6,4"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel x:Name="RecentSection">
                                <DockPanel Margin="10,2,4,4">
                                    <Button x:Name="ClearRecentButton" DockPanel.Dock="Right" Style="{StaticResource SidebarActionButton}"
                                            Height="22" Padding="6,0" Visibility="Collapsed" ToolTip="清空最近查阅记录" Click="ClearRecentFiles">
                                        <TextBlock Text="清空" FontSize="11" />
                                    </Button>
                                    <TextBlock Text="最近查阅" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock x:Name="RecentEmptyHint" Text="拖入 .md / .tex 文档即可开始阅读" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="10,2,8,8" TextWrapping="Wrap" />
                                <ItemsControl x:Name="RecentFiles">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" CornerRadius="6" Margin="0,1" Background="Transparent">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="从最近查阅中移除" Tag="{Binding Path}" Click="RemoveRecentFile" />
                                                        <Separator />
                                                        <MenuItem Header="清空全部最近查阅" Click="ClearRecentFiles" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid Height="32">
                                                    <Button Style="{StaticResource SidebarActionButton}" Height="32" Padding="8,0,28,0"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                            Tag="{Binding Path}" ToolTip="{Binding Path}" Click="OpenRecentFile">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="3" Height="14" CornerRadius="1.5" Margin="0,0,8,0"
                                                                    Background="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                    Visibility="{Binding ActiveVisibility}" />
                                                            <TextBlock x:Name="RecentLabel" Grid.Column="1" Text="{Binding DisplayName}" FontSize="12.5"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                    <Button x:Name="RemoveButton" Style="{StaticResource GhostIconButton}"
                                                            Width="22" Height="22" Margin="0,0,4,0"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            Visibility="Collapsed" Tag="{Binding Path}"
                                                            ToolTip="移除此条记录" Click="RemoveRecentFile">
                                                        <Path Data="M4.5,4.5 L11.5,11.5 M11.5,4.5 L4.5,11.5"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              Width="9" Height="9" Stretch="Uniform" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="RecentLabel" Property="FontWeight" Value="SemiBold" />
                                                    <Setter TargetName="RecentLabel" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="RecentLabel" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border x:Name="SheetContainer" Grid.Column="1" Margin="0,0,8,8" CornerRadius="10"
                    BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <web:WebView2CompositionControl x:Name="Canvas" DefaultBackgroundColor="Transparent"
                                                    AllowExternalDrop="False" />
                    <TextBlock x:Name="HostError" TextWrapping="Wrap" Visibility="Collapsed"
                               Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
